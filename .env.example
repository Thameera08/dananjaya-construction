# ── Neon Postgres (added automatically by the Vercel ⇄ Neon Marketplace integration) ──
# Pooled (PgBouncer) URL — used by the app at runtime via the Neon HTTP driver
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct URL — used by drizzle-kit (push/migrate) and the seed / create-admin scripts
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ──
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# ── Vercel Blob (private store) — added when you connect a Blob store to the project ──
BLOB_READ_WRITE_TOKEN=""

# ── Letterhead on PDFs / Excel (optional) ──
COMPANY_NAME="Dananjaya Construction"
COMPANY_ADDRESS="Colombo, Sri Lanka"
COMPANY_PHONE=""
COMPANY_EMAIL=""

# ── Seeding (local only; optional) ──
# If unset, strong random passwords are generated and printed once by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@dananjaya.lk"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
